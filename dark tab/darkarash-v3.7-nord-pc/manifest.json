{
  "manifest_version": 2,
  "name": "darkash-v3.7-pc-nord",
  "version": "1.0",
  "description": "this is my ext for my browser home page",
  "icons": {
    "128": "icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "darktab@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "<all_urls>"
  ]
}
